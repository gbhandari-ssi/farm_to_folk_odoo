<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_upload_po_wizard_form" model="ir.ui.view">
        <field name="name">upload.po.wizard.form</field>
        <field name="model">upload.po.wizard</field>
        <field name="arch" type="xml">
            <form string="Upload Purchase Order">
                <group>
                    <field name="sale_order_id" invisible="1"/>
                    <field name="po_filename" invisible="1"/>
                    <field name="po_document" filename="po_filename" widget="binary"/>
                </group>
                <footer>
                    <button string="Upload PO" name="action_upload" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_po_attachment_list" model="ir.ui.view">
        <field name="name">po.attachment.clean.list</field>
        <field name="model">ir.attachment</field>
        <field name="arch" type="xml">
            <list string="Purchase Orders" create="0" edit="0" delete="0">
                
                <field name="is_sale_invoiced" column_invisible="True"/>

                <field name="name" string="Document Name"/>
                <field name="create_uid" string="Uploaded By" widget="many2one_avatar_user"/>
                <field name="create_date" string="Date"/>
                <field name="datas" filename="name" widget="binary" string="Download"/>
                
                <button name="action_replace_po_from_list" type="object" string="Replace" icon="fa-refresh" class="btn-secondary"/>
                
                <button name="action_remove_po_from_list" type="object" string="Remove" icon="fa-trash" class="btn-danger" invisible="is_sale_invoiced"/>
            </list>
        </field>
    </record>

    <record id="view_order_form_inherit_po_upload" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.po.upload</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="po_received" invisible="1"/>
                <field name="po_attachment_id" invisible="1"/>
            </xpath>

            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_po"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-file-text-o"
                        invisible="not po_attachment_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">View PO</span>
                    </div>
                </button>
            </xpath>

            <xpath expr="//header/button[@name='action_quotation_send']" position="before">
                <button name="action_open_po_wizard"
                        string="Upload PO"
                        type="object"
                        class="oe_highlight"
                        invisible="state not in ['sale'] or po_received"/>
            </xpath>

            <xpath expr="//button[@id='create_invoice']" position="attributes">
                <attribute name="invisible">invoice_status != 'to invoice' or not po_received</attribute>
            </xpath>
            <xpath expr="//button[@id='create_invoice_percentage']" position="attributes">
                <attribute name="invisible">invoice_status != 'no' or state != 'sale' or not po_received</attribute>
            </xpath>
            
        </field>
    </record>

</odoo>