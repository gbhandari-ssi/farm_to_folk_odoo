<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_upload_grn_wizard_form" model="ir.ui.view">
        <field name="name">upload.grn.wizard.form</field>
        <field name="model">upload.grn.wizard</field>
        <field name="arch" type="xml">
            <form string="Upload GRN">
                <group>
                    <field name="picking_id" invisible="1"/>
                    <field name="grn_filename" invisible="1"/>
                    <field name="grn_document" filename="grn_filename" widget="binary"/>
                </group>
                <footer>
                    <button string="Upload GRN" name="action_upload" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_grn_attachment_list" model="ir.ui.view">
        <field name="name">grn.attachment.clean.list</field>
        <field name="model">ir.attachment</field>
        <field name="arch" type="xml">
            <list string="GRN Documents" create="0" edit="0" delete="0">
                
                <field name="is_picking_done" column_invisible="True"/>

                <field name="name" string="Document Name"/>
                <field name="create_uid" string="Uploaded By" widget="many2one_avatar_user"/>
                <field name="create_date" string="Date"/>
                <field name="datas" filename="name" widget="binary" string="Download"/>
                
                <button name="action_replace_grn_from_list" type="object" title="Replace GRN" icon="fa-refresh" class="btn-secondary"/>
                
                <button name="action_remove_grn_from_list" type="object" title="Remove GRN" icon="fa-trash" class="btn-danger" 
                        confirm="Are you sure you want to permanently delete this GRN document?" 
                        invisible="is_picking_done"/>
            </list>
        </field>
    </record>

    <record id="view_picking_form_inherit_grn_upload" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.grn.upload</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            
            <xpath expr="//field[@name='origin']" position="after">
                <field name="grn_received" invisible="1"/>
                <field name="grn_attachment_id" invisible="1"/>
            </xpath>

            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_grn"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-file-text-o"
                        invisible="not grn_attachment_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">View GRN</span>
                    </div>
                </button>
            </xpath>

            <xpath expr="//header/button[@name='button_validate'][1]" position="before">
                <field name="picking_type_code" invisible="1"/>
                <button name="action_open_grn_wizard"
                        string="Upload GRN"
                        type="object"
                        class="oe_highlight"
                        invisible="picking_type_code != 'outgoing' or grn_received or state == 'done'"/>
            </xpath>
            
        </field>
    </record>

</odoo>