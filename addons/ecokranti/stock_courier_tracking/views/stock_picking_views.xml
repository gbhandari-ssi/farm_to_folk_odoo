<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_inherit_courier_tracking" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.courier.tracking</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            
            <xpath expr="//notebook" position="before">
                <group string="Courier Tracking" name="custom_courier_tracking" invisible="picking_type_code == 'incoming'">
                    <group>
                        <field name="delivery_partner"/>
                        <field name="tracking_link" widget="url"/>
                    </group>
                    <group>
                        <field name="tracking_id"/>
                    </group>
                </group>
            </xpath>

        </field>
    </record>
</odoo>