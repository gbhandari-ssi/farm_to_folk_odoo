<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_register_form_inherit_proof" model="ir.ui.view">
        <field name="name">account.payment.register.form.inherit.proof</field>
        <field name="model">account.payment.register</field>
        <field name="inherit_id" ref="account.view_account_payment_register_form"/>
        <field name="arch" type="xml">
            
            <xpath expr="//div[@name='amount_div']" position="after">
                <field name="payment_proof_filename" invisible="1"/>
                <field name="payment_proof" filename="payment_proof_filename" widget="binary"/>
            </xpath>
            
        </field>
    </record>
</odoo>