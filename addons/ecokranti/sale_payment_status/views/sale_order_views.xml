<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_tree_inherit_payment_status" model="ir.ui.view">
        <field name="name">sale.order.tree.inherit.payment.status</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="arch" type="xml">
            
            <xpath expr="//field[@name='invoice_status']" position="after">
                <field name="payment_status" 
                       widget="badge" 
                       decoration-success="payment_status == 'Fully Paid'" 
                       decoration-info="payment_status == 'Partially Paid'" 
                       decoration-danger="payment_status == 'Not Paid'" 
                       optional="show"/>
            </xpath>

        </field>
    </record>
</odoo>