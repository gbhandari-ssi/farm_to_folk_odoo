<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_lead_view_form_inherit_last_quote" model="ir.ui.view">
        <field name="name">crm.lead.form.inherit.last.quote</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            
            <xpath expr="//field[@name='expected_revenue']/.." position="after">
                
                <div class="mt-2" invisible="stage_id != 6">
                    <label for="last_quote_amount" class="oe_inline fw-bold me-2"/>
                    <field name="last_quote_amount" class="oe_inline" widget="monetary" options="{'currency_field': 'company_currency'}"/>
                </div>
                
            </xpath>

        </field>
    </record>
</odoo>