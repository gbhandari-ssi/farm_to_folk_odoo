<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_crm_lead_form_inherit_interested" model="ir.ui.view">
        <field name="name">crm.lead.form.inherit.interested</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='internal_notes']" position="before">
                <page string="Interested Products" name="interested_products">
                    <field name="interested_line_ids">
                        <list editable="bottom">
                            <field name="product_id" context="{'search_default_group_by_product_tmpl_id': 1}"/>
                            <field name="quantity"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>